		CG_EHIGH:category = "thermal properties" ;
		CG_EHIGH:default_value = 222500. ;
		CG_EHIGH:comment = "Independent PFT trait; legacy model value retained as the default." ;
	double LG_ELOW(npfts) ;
		LG_ELOW:long_name = "Leaf/node phenology low-temperature inactivation energy" ;
		LG_ELOW:units = "J mol-1" ;
		LG_ELOW:category = "thermal properties" ;
		LG_ELOW:default_value = 197500. ;
		LG_ELOW:comment = "Independent PFT trait; legacy model value retained as the default." ;
	double LG_EHIGH(npfts) ;
		LG_EHIGH:long_name = "Leaf/node phenology high-temperature inactivation energy" ;
		LG_EHIGH:units = "J mol-1" ;
		LG_EHIGH:category = "thermal properties" ;
		LG_EHIGH:default_value = 218500. ;
		LG_EHIGH:comment = "Independent PFT trait; legacy model value retained as the default." ;
	float FL_POPT(npfts) ;
		FL_POPT:units = "h" ;
		FL_POPT:long_name = "Fully inductive photoperiod boundary for floral development" ;
		FL_POPT:comment = "Negative values select site-resolved XDL. For short-day plants, daylength above this boundary delays floral induction; for long-day plants, daylength below it delays induction. Independent of XPPD." ;
		FL_POPT:valid_range = -1.f, 24.f ;
		FL_POPT:default_value = -1.f ;
	float FL_PSENS(npfts) ;
		FL_PSENS:units = "h-1" ;
		FL_PSENS:long_name = "Exponential floral development sensitivity to adverse photoperiod" ;
		FL_PSENS:comment = "Cumulative annual-evergreen floral induction uses exp(-min(50,FL_PSENS*adverse_photoperiod_hours)); 0 means no photoperiod delay. This is not XPPD." ;
		FL_PSENS:valid_range = 0.f, 1000000.f ;
		FL_PSENS:default_value = 0.f ;

