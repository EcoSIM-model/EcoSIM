&regression_test
 cells   =           3
/

&ecosim
case_name='Blodget.ndlf.lig'
do_regression_test=.false.
pft_file_in='../../inputs/blodgett/ndlf34.nc'
grid_file_in='../../inputs/blodgett/Blodget_grid_20251115.nc'
pft_mgmt_in='../../inputs/blodgett/Blodget_pft_20260426.ndlf.nc'
clm_hour_file_in='../../inputs/blodgett/Blodget.clim.2012-2022.nc'
clm_factor_in='NO'
soil_mgmt_in='NO'
lcoarseroot=.true.
atm_ghg_in='../../../input_data/fatm_hist_GHGs_1750-2023.nc'
!idebug_day=2
lsoilCompaction=.false.
!lverbose=.true.
plantOM4Heat=.true.
disp_planttrait=.true.
plant_model=.true.
!llignification=.true.
microbial_model=.true.
soichem_model=.true.
!set up output variable lists
!set up the first year of simulation
start_date  = '19410101000000'
grid_mode=1    !enable lateral runoff
continue_run=.false.
!set up simulation periods, spinup starts at 1, ends at 2, with 3 cycles, regular starts at 4, ends at 5.
forc_periods=2012,2015,18,2012,2022,1,2012,2022,0

!set up solvers
NPXS=30,30,30      !number of cycles per hour for water,heat,solute flux calcns
NPYS=10,10,10      !number of cycles per NPX for gas flux calcns
NCYC_LITR=30
NCYC_SNOW=20
!set up output frequency
hist_mfilt=7300 !, 240
!hist_fincl2 = 'AIR_TEMP','TEMP_vr','PREC','SOIL_RN','SOIL_LE','SOIL_G','SOIL_H','SOL_RADN','WIND','EVAPN',
!  'RUNOFF_FLX','rWatFILLP_vr','rIceFILLP_vr','SNOWPACK','SURF_WTR'
hist_fincl1='ECO_RA_col','ECO_RH_col','ECO_NPP_col', 'Root_AR_col','ECO_HR_CO2_col','Root1stSinkWeight_pvr',
  'TEMP_vr','rWatFLP_vr','BOTDEPZ_vr','tSOC_vr','RootC_vr','RootC_2nd_pvr','CanopyLAIZ_plyr','Root2ndSinkWeight_pvr',
  'RUB_ACTVN_pft','RootNutUptk_fClim_pvr','RootNutUptk_fNlim_pvr','RootNutUptk_fPlim_pvr','RootNutUptk_fProtC_pvr',
  'HR_CO2_vr','Root_OXYSTRESS_pvr','Decomp_OStress_vr','Decomp_OStress_LITR','GasXSurfConduct_col','CO2_DIF_FLX_col',
  'CO2_PLTROOT_FLX_col','TreeRingRadius_pft','RootLDS_pvr','RootKond2H2O_pvr','Growth_Stage_pft','PSI_vr','MycoArbuBiomC_pft',
  'VcMax25C_RUBISCO_pft','VoMax25C_RUBISCO_pft','JMax25C_photo_pft','ShootRoot_XFER_C_pft','ShootRoot_XFER_N_pft','CRootLumenArea_pvr',
  'MicPFlo_vr','MacPFlo_vr','dCAN_GPP_CLIM_pft','dCAN_GPP_eLIM_pft','RootNonstC_pvr','Root1stRadius_pvr','ShootRoot_XFER_C_pft',
  'Root2nd_AxesNumL_pvr','Root1st_AxesNumL_pvr','RootShootCX_pvr','Root1stTipSinkwt_pft','Cytok_scalar_pvr','Cytokinin1stConc_pvr',
  'Root1stLenPP_pvr','RootMed_AxesNumL_pvr','RootMed_length_pvr','RootMed_radius_pvr'
!hist_fincl2='TEMP_vr' !,'CO2_SEMIS_FLX_col','Root_AR_col','ECO_HR_CO2_col','ECO_RADSW_col'
!hist_fincl2='ECO_GPP_col','ECO_NPP_col'
hist_nhtfrq=-24 !, 0
/

&bbgcforc
/

!namelist for timer
&ecosim_time
rest_opt='nyears'  !'ndays','nmonths','nyears'
rest_frq=1
delta_time=3600.
stop_n=  40 !82            !this shall overwrite what is set in forc_periods
stop_option='nyears' !run by nyears, nmonths, ndays,
diag_frq=1
diag_opt='nsteps'
/



