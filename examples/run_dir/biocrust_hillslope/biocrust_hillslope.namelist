&regression_test
 cells   =           3
/

&ecosim
case_name='Biocrust_Hillslope'
prefix='../../inputs/biocrust_hillslope/'
do_regression_test=.false.
pft_file_in='../../../input_data/ecosim_pftpar_20261021.nc'
grid_file_in='../../../examples/inputs/biocrust_hillslope/biocrust_hillslope_grid_20261001.nc'
pft_mgmt_in='../../../examples/inputs/biocrust_hillslope/biocrust_hillslope_pft_mgmt_20261001.nc'
clm_hour_file_in='../../../examples/inputs/biocrust/BareSoil_clim_20250203.nc'
clm_factor_in='NO'
soil_mgmt_in='NO'
atm_ghg_in='../../../input_data/fatm_hist_GHGs_1750-2025.nc'

lverbose=.false.
disp_planttrait = .true.
plant_model     = .true.
microbial_model = .true.
soichem_model   = .true.
!set up output variable lists
!set up the first year of simulation
start_date  = '18000101000000'
grid_mode=1
continue_run=.false.
!set up simulation periods, spinup starts at 1, ends at 2, with 3 cycles, regular starts at 4, ends at 5.
forc_periods=1980,1989,2,1981,1983,0,1991,2008,0

!set up solvers
NPXS=30,30,30      !number of cycles per hour for water,heat,solute flux calcns
NPYS=10,10,10      !number of cycles per NPX for gas flux calcns
NCYC_LITR=20
NCYC_SNOW=20

hist_fincl1='O2w_conc_vr','N2w_conc_vr','Arw_conc_vr','H2w_conc_vr','NH3w_conc_vr',
  'N2Ow_conc_vr','CH4w_conc_vr','CO2w_conc_vr','CO2_gas_ppmv_vr','O2_gas_ppmv_vr',
  'N2O_gas_ppmv_vr','CH4_gas_ppmv_vr','N2_gas_ppmv_vr','H2_gas_ppmv_vr','NH3_gas_ppmv_vr',
  'Ar_gas_ppmv_vr','CynoBacterE_litr','PAR_vr'

!set up output frequency
hist_mfilt=1460
hist_nhtfrq=-24
/

&bbgcforc
/

!namelist for timer
&ecosim_time
rest_opt='nyears'  !'ndays','nmonths','nyears'
rest_frq=1
delta_time=3600.
stop_n=8            !this shall overwrite what is set in forc_periods
stop_option='nyears' !run by nyears, nmonths, ndays,
diag_frq=1
diag_opt='nsteps'
/
